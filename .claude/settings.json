{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "deny": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Bash(gh *)",
      "Bash(aws *)",
      "Bash(terraform *)",
      "mcp__*",
      "Read(~/.aws/**)",
      "Read(**/backend.hcl)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)"
    ]
  }
}