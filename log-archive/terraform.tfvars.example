# Copy to terraform.tfvars (gitignored) and fill in your values.
aws_profile = "your-log-archive-profile"

# The organization's management account ID (12 digits).
management_account_id = "123456789012"

# The Organization ID, shown in the AWS Organizations console under Settings.
organization_id = "o-xxxxxxxxxx"

# The account ID of the shared security account, which administers GuardDuty.
# This is not the log archive account this configuration is applied to.
security_account_id = "210987654321"